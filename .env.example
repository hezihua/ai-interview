# ===== LLM（OpenRouter 原生 ChatOpenRouter，不经 OpenAI 客户端）=====
# 用法：取消注释想用的 MODEL，并注释掉其它 MODEL 行（同时只能有一行生效）
#
# --- DeepSeek ---
MODEL=openrouter:deepseek/deepseek-chat
# MODEL=openrouter:deepseek/deepseek-chat-v3-0324
# MODEL=openrouter:deepseek/deepseek-v3.2
# MODEL=openrouter:deepseek/deepseek-r1
# MODEL=openrouter:deepseek/deepseek-r1-0528
# MODEL=openrouter:deepseek/deepseek-v4-flash
# MODEL=openrouter:deepseek/deepseek-v4-pro
#
# --- 通义千问 Qwen（阿里）---
# MODEL=openrouter:qwen/qwen3-8b
# MODEL=openrouter:qwen/qwen3-32b
# MODEL=openrouter:qwen/qwen-2.5-72b-instruct
# MODEL=openrouter:qwen/qwen3.6-max-preview
# MODEL=openrouter:qwen/qwq-32b
#
# --- 智谱 GLM ---
# MODEL=openrouter:z-ai/glm-4.5
# MODEL=openrouter:z-ai/glm-4.5-air
# MODEL=openrouter:z-ai/glm-5
#
# --- 月之暗面 Kimi / Moonshot ---
# MODEL=openrouter:moonshotai/kimi-k2
# MODEL=openrouter:moonshotai/kimi-k2-0905
#
# --- 其它国内相关 ---
# MODEL=openrouter:minimax/minimax-m2.5
# MODEL=openrouter:tencent/hunyuan-a13b-instruct
# MODEL=openrouter:baidu/ernie-4.5-21b-a3b

OPENROUTER_API_KEY=sk-or-v1-...

# Cursor Dashboard 的 crsr_ key：仅用于 Cursor SDK / Cloud Agents，不能当模型 key
# CURSOR_API_KEY=crsr_...

# ===== Job Search MCP（mcp/ 与 Agent 共用本文件）=====
# 档案、岗位、申请材料目录（相对仓库根目录或绝对路径）
WORKSPACE_DIR=workspace

# stdio = Cursor 拉起 mcp/server.py；streamable-http = 常驻给 Agent
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8765
MCP_PATH=/mcp
MCP_ALLOWED_HOSTS=*

# 本机 CLI / python server/server.py 用 127.0.0.1；compose 内 server 覆盖为 http://mcp:8765/mcp
MCP_URL=http://127.0.0.1:8765/mcp
MCP_AUTH_TOKEN=change-me-to-a-long-random-string

# ===== FastAPI（server/）=====
API_HOST=0.0.0.0
API_PORT=8766
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
# 可选；设置后需带 Authorization: Bearer <token>
# API_AUTH_TOKEN=
